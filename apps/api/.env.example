# Copie para apps/api/.env e preencha. NUNCA versione o .env.

PORT=8787
# Origem do frontend autorizada pelo CORS
WEB_ORIGIN=http://localhost:5173

# Supabase → Project Settings → API
SUPABASE_URL=https://uklykrjfzrdaqjvuhfwv.supabase.co
SUPABASE_ANON_KEY=
# Chave secreta (service_role). Usada SOMENTE no servidor, ex.: exclusão de conta.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Controle de custos: requisições de IA por usuário por hora
AI_RATE_LIMIT_PER_HOUR=40
